package com.fitfusion.customer.services;

import java.util.Optional;

import org.modelmapper.ModelMapper;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;

import com.fitfusion.customer.dtos.ChangePasswordRequestDto;
import com.fitfusion.customer.dtos.CustomerResponseDto;
import com.fitfusion.customer.dtos.LoginRequestDto;
import com.fitfusion.customer.dtos.SignUpRequestDto;
import com.fitfusion.customer.dtos.UpdateCustomerRequestDto;
import com.fitfusion.customer.exceptions.EmailAlreadyExistsException;
import com.fitfusion.customer.exceptions.InvalidCredentialsException;
import com.fitfusion.customer.models.Customer;
import com.fitfusion.customer.repositories.CustomerRepo;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class CustomerServiceImpl implements CustomerService {

    private final CustomerRepo customerRepo;
    private final ModelMapper modelMapper;
    private final PasswordEncoder passwordEncoder;

	@Override
	public CustomerResponseDto signup(SignUpRequestDto request) {
		if(customerRepo.existsByEmail(request.getEmail())) {
			throw new EmailAlreadyExistsException("An account with email "+ request.getEmail()+ " already exists");
		}
		Customer customer=  modelMapper.map(request, Customer.class);
		customer.setPassword(passwordEncoder.encode(request.getPassword()));
		Customer savedCustomer= customerRepo.save(customer);
		CustomerResponseDto customerResponse= modelMapper.map(savedCustomer, CustomerResponseDto.class);
		return customerResponse;
	}

	@Override
	public String login(LoginRequestDto request) {
		
		return null;
	}

	@Override
	public CustomerResponseDto getProfile(String customerEmail) {
		Customer customer= customerRepo.findByEmail(customerEmail).orElseThrow(() -> new RuntimeException("Email not found"));
		CustomerResponseDto customerResponse= modelMapper.map(customer, CustomerResponseDto.class);
		return customerResponse;
	}

	@Override
	public CustomerResponseDto updateProfile(String customerEmail, UpdateCustomerRequestDto request) {
		Customer c= customerRepo.findByEmail(customerEmail).orElseThrow(()-> new RuntimeException("Email not found"));
		c.setMobile(request.getMobile());
		c.setName(request.getName());
		return modelMapper.map(c, CustomerResponseDto.class);
	}

	@Override
	public CustomerResponseDto changePassword(String customerEmail, ChangePasswordRequestDto request) {
		Customer c= customerRepo.findByEmail(customerEmail).orElseThrow(()-> new RuntimeException("Email not found"));
		if(!passwordEncoder.matches(c.getPassword(), request.getOldPassword())) {
			throw new InvalidCredentialsException("invalid password");
		}
		c.setPassword(passwordEncoder.encode(request.getNewPassword()));
		return modelMapper.map(c, CustomerResponseDto.class);
	}

}
